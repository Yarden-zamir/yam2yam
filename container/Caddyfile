{
	auto_https off
	admin off
}

http:// {
	bind unix/{$KITSHN_DEFAULT_SOCKET}|0666
	root * /srv
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type application/gpx+xml*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}
	@fresh path / /index.html /sw.js /*.js /*.css /vendor/* /manifest.webmanifest /*.gpx
	header @fresh Cache-Control "no-cache"
	@gpx path *.gpx
	header /maps/* Cache-Control "public, max-age=604800"
	header @gpx Content-Type application/gpx+xml
	header @gpx Content-Disposition attachment
	# trip logs: pictures live on the volume shared with the uploader, uploads go to it.
	# The index and the page's edits change on the page itself, so they are never cached;
	# their own handle block, since a second header directive in one block does not override the first.
	@livejson path /log/*/photos/*.json
	handle @livejson {
		uri strip_prefix /log
		root * /data
		header Cache-Control "no-cache"
		file_server
	}
	# link previews (og:image): a 1200 x 630 crop the uploader makes on the first request
	@og path /log/*/photos/*.og.jpg
	handle @og {
		reverse_proxy uploader:8080
	}
	@photos path /log/*/photos/*
	handle @photos {
		uri strip_prefix /log
		root * /data
		header Cache-Control "public, max-age=86400"
		file_server
	}
	@orig path /log/*/orig/*
	handle @orig {
		uri strip_prefix /log
		root * /data
		header Cache-Control "public, max-age=86400"
		file_server
	}
	@upload path /log/*/upload /log/*/reindex /log/*/edit
	handle @upload {
		request_body {
			max_size 160MB
		}
		reverse_proxy uploader:8080
	}
	handle {
		file_server
	}
}
