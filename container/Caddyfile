{
	auto_https off
	admin off
}

http:// {
	bind unix/{$KITSHN_DEFAULT_SOCKET}|0666
	root * /srv
	# never trust the signed-in login from the client; forward_auth sets it below
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type application/gpx+xml*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}
	@fresh path / /index.html /sw.js /*.js /*.css /vendor/* /manifest.webmanifest /*.gpx
	header @fresh Cache-Control "no-cache"
	@gpx path *.gpx
	header /maps/* Cache-Control "public, max-age=604800"
	header @gpx Content-Type application/gpx+xml
	header @gpx Content-Disposition attachment
	# trip logs: pictures live on the volume shared with the uploader, uploads go to it.
	# The index and the page's edits change on the page itself, so they are never cached;
	# their own handle block, since a second header directive in one block does not override the first.
	@livejson path /log/*/photos/*.json
	handle @livejson {
		uri strip_prefix /log
		root * /data
		header Cache-Control "no-cache"
		file_server
	}
	# link previews (og:image): a 1200 x 630 crop the uploader makes on the first request
	@og path /log/*/photos/*.og.jpg
	handle @og {
		reverse_proxy uploader:8080
	}
	@photos path /log/*/photos/*
	handle @photos {
		uri strip_prefix /log
		root * /data
		header Cache-Control "public, max-age=86400"
		file_server
	}
	@orig path /log/*/orig/*
	handle @orig {
		uri strip_prefix /log
		root * /data
		header Cache-Control "public, max-age=86400"
		file_server
	}
	# GitHub sign-in (oauth2-proxy): sign_in, callback, sign_out live under /auth/*
	@auth path /auth/*
	handle @auth {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}
	# editing and "who am I": through the gate; a visitor who is not signed in gets a JSON 401, never a redirect
	@upload path /log/*/upload /log/*/reindex /log/*/edit /log/*/whoami
	handle @upload {
		forward_auth oauth2-proxy:4180 {
			uri /auth/auth
			header_up X-Real-IP {remote_host}
			copy_headers X-Auth-Request-User X-Auth-Request-Email
			@error status 401
			handle_response @error {
				header Content-Type application/json
				header Cache-Control no-store
				respond "{\"login\": null, \"editor\": false, \"auth\": true, \"signin\": true, \"error\": \"sign in with GitHub\"}" 401
			}
		}
		request_body {
			max_size 160MB
		}
		reverse_proxy uploader:8080
	}
	handle {
		file_server
	}
}
