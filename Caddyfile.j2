{{ host("yam2yam.yarden-zamir.com") }} {
    reverse_proxy unix//{{ paths.default_socket }}
{% if environment == "prod" %}    log {
        output file /var/log/caddy/{{ deployment | replace("/", "-") }}.access.log {
            roll_size 20MiB
            roll_keep 100
            roll_keep_for 2160h
        }
        format json
    }
{% endif %}{% if environment != "prod" %}    header X-Robots-Tag "noindex, nofollow"
{% endif %}}
